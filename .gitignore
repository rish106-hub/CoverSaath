# Keep identifiers, medical records, interview recordings and credentials out of a future repository.
.DS_Store
.env
.env.*
!.env.example
private/
docs/evidence/
*.key
*.pem
node_modules/
dist/
.insforge/
coverage/
.local/
.claude/prompts/block-1-input-slice.xml
docs/exec-plans/active/handoff-codex.md
docs/exec-plans/active/production-hardening.xml

# Build archives stay local, not in the repository.
*.zip
# Local databases and eval output, wherever they are written.
*.sqlite
*.sqlite-shm
*.sqlite-wal
# PostgreSQL runner tests write scratch migration sets here (tests/support/postgres.mjs).
src/backend/database/postgres/migrations/test-scratch/

# Local agent and editor state. Launch configs and MCP configs can carry tokens, keys and project URLs.
.claude/launch.json
.claude/settings.local.json
.claude/worktrees/
.mcp.json
.vscode/
.idea/

# Logs and scratch output.
*.log
npm-debug.log*
.tmp/
