# Copy these settings into .env.local. The server loads that ignored file.
# Never place keys in VITE_ variables or send them in chat.
# PostgreSQL connection string (server-only secret). For Supabase use the session pooler, see docs/runbooks/fly-deploy.md.
DATABASE_URL=
# Optional PEM CA file for a hosted database; the pool then verifies the server certificate.
DATABASE_SSL_CA_PATH=
# Generate a random 32-byte value. Used only to create the first local household.
KNOWVIA_BOOTSTRAP_TOKEN=
# Sign-in identities (POST /api/v1/identity-sessions). Held only by the website server (BFF). 32 to 256 characters of
# A-Z a-z 0-9 _ -, and different from the bootstrap token. Unset: the route answers 503 AUTH_NOT_CONFIGURED.
KNOWVIA_IDENTITY_TOKEN=
# Exact issuer strings the route accepts, comma-separated (no wildcards). Unset: every request is refused.
# List each issuer in exactly one canonical form (for example not both accounts.google.com and https://accounts.google.com):
# the same person under two spellings would become two adults.
IDENTITY_ISSUERS=
API_RATE_LIMIT_PER_MINUTE=600
SESSION_TTL_SECONDS=3600
MAX_ACTIVE_SESSIONS=100
MAX_ACTIVE_CASES=100
MAX_RUNS_PER_CASE=10

# Private manual-upload storage. Generate a 32-byte random value and store its
# base64 form only in .env.local. Without it, live document intake fails closed.
DOCUMENT_STORAGE_PATH=.local/documents
DOCUMENT_ENCRYPTION_KEY_BASE64=
# Malware scanning for uploads: disabled (default; uploads stay quarantined) or clamd.
DOCUMENT_SCAN_MODE=disabled
# Production: true. Startup fails unless DOCUMENT_SCAN_MODE=clamd, and /api/v1/ready is not_ready while clamd does not answer.
DOCUMENT_SCAN_REQUIRED=false
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=30000
MAX_DOCUMENTS_PER_CASE=50
MAX_PENDING_DOCUMENTS_PER_HOUSEHOLD=20
DOCUMENT_WORKER_SWEEP_MS=30000

# Live runs need explicit model-sharing permission in addition to case consent.
LLM_PROVIDER=google
GEMINI_API_KEY=
# Set an account-available model and its current rates from Google's official documentation.
LLM_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
ORCHESTRATION_RUN_BUDGET_USD=0.25
ORCHESTRATION_PROJECT_BUDGET_USD=5
# Optional live-model limits. Leave them commented to use the defaults shown; an empty value is
# rejected. LLM_MODEL_VERSION defaults to LLM_MODEL. GOOGLE_GENERATIVE_AI_API_KEY is accepted in
# place of GEMINI_API_KEY.
# LLM_MODEL_VERSION=
# LLM_MAX_INPUT_BYTES=48000
# LLM_MAX_OUTPUT_TOKENS=1500
# LLM_TIMEOUT_MS=30000
# LLM_MAX_CONCURRENT_CALLS=2

# Feature switches. Each is off unless set to exactly "true". Question answers (POST .../questions and the
# decision catalogue read) answer 503 EVIDENCE_DISABLED until POLICY_EVIDENCE_ENABLED=true; they also need a
# Gemini key, document OCR output and a question-time consent. Enabling a switch does not call a provider.
POLICY_EVIDENCE_ENABLED=false
POLICY_STRUCTURING_ENABLED=false
# Policy profile (GET/POST /api/v1/documents/{id}/policy-profile): the UIN, insurer and policy name of an owned document and the
# owner's confirmation of them, and (GET .../policy-facts, worker job policy_facts.extract) the datapoints read from it with their
# evidence. Off unless exactly "true". Makes no model or provider call.
POLICY_FACTS_ENABLED=false
# Read-back of values and passages from the owner's own read documents (GET .../read-facts). Off unless exactly
# "true"; makes no model call and does not need POLICY_EVIDENCE_ENABLED.
DOCUMENT_READBACK_ENABLED=false
# Chat v0 (POST /api/v1/households/{id}/chat): deterministic, cited lookup over the household's own read documents. No
# model, nothing stored. Off unless exactly "true"; also needs DOCUMENT_READBACK_ENABLED=true. docs/runbooks/chat-v0.md.
CHAT_ENABLED=false
# Independent catalogue reviewers (operator-granted). Household confirmers do not need this.
CATALOGUE_INDEPENDENT_REVIEW_ENABLED=false

# Sarvam Document AI is off by default. Enabling it sends clean, consented documents to Sarvam.
# The API key stays server-side. Defaults shown below bound time, retries, concurrency and cost.
SARVAM_OCR_ENABLED=false
SARVAM_API_KEY=
SARVAM_OCR_TIMEOUT_MS=30000
SARVAM_OCR_MAX_CONCURRENT=2
SARVAM_OCR_MAX_RETRIES=2
SARVAM_OCR_RETRY_DELAY_MS=250
SARVAM_OCR_MAX_DOCUMENT_PAGES=100
# Other provider placeholders remain fail-closed until their contracts are implemented.
GNANI_API_KEY_ID=
PINE_LABS_CLIENT_ID=
PINE_LABS_CLIENT_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=

# Column encryption (ADR 0013). Sensitive text columns are sealed with AES-256-GCM before they are stored. Required in
# production (NODE_ENV=production) and whenever DATA_ENCRYPTION_REQUIRED=true; startup fails without it. In development a fixed
# public key is used when this is empty, which protects nothing. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY_BASE64=
# DATA_ENCRYPTION_KEY_ID=k1
# For a rotation: new key above with a new id, old keys here, then run scripts/encrypt-existing-rows.mjs --rotate
# DATA_ENCRYPTION_PREVIOUS_KEYS_JSON={"k0":"<base64 32 bytes>"}
# DATA_ENCRYPTION_REQUIRED=true
# The public development key is refused for any DATABASE_URL that is not on this machine, and by scripts/encrypt-existing-rows.mjs
# unless --allow-development-key (local throwaway databases only).
# "false" refuses unsealed (legacy plaintext) values on read; set it only after the backfill reports 0 rows.
# DATA_ENCRYPTION_LEGACY_PLAINTEXT=true
# Where encrypted document bytes live: database (default) or filesystem (DOCUMENT_STORAGE_PATH). Documents stored under the
# other backend stay readable. The document key (DOCUMENT_ENCRYPTION_KEY_BASE64) is needed for both.
# DOCUMENT_STORAGE_BACKEND=database

# Logging and error reporting (ADR 0016)
# LOG_LEVEL=info
# SENTRY_DSN=

# Reference data (insurance-data-api, X1 audit) is off unless exactly "true". Read-only public insurer, product and
# fact context; never household data. Key stays server-side. ADR 0021, docs/runbooks/ida-integration.md.
# Import-only mode (default when enabled): leave REFERENCE_DATA_BASE_URL empty and load rows with
# scripts/reference-import.mjs; no service is called. Service mode: set the base URL (https, or http on loopback for a
# local insurance-data-api) and REFERENCE_DATA_API_KEY; startup fails if the base URL is set without the key.
REFERENCE_DATA_ENABLED=false
REFERENCE_DATA_BASE_URL=
REFERENCE_DATA_API_KEY=
REFERENCE_DATA_TIMEOUT_MS=2000
REFERENCE_DATA_MAX_RESPONSE_BYTES=262144
# Holdings (insurer detection, confirm-product, reference import). Off unless exactly "true". The reference import also needs
# REFERENCE_DATA_ENABLED=true and a reference service key with the facts:export and service:uin scopes.
HOLDINGS_ENABLED=false
# Memory and chat v1 (ADR 0031): off unless exactly true. Embeddings need MODEL_PROVIDERS to include voyage, VOYAGE_API_KEY and VOYAGE_INPUT_USD_PER_MILLION.
MEMORY_ENABLED=false
CHAT_MODEL_ENABLED=false
VOICE_AUDIO_RETAIN=false
