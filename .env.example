# Copy these settings into .env.local. The server loads that ignored file.
# Never place keys in VITE_ variables or send them in chat.
# Local SQLite file. Keep it under the ignored .local directory.
DATABASE_PATH=.local/knowvia.sqlite
# Generate a random 32-byte value. Used only to create the first local household.
KNOWVIA_BOOTSTRAP_TOKEN=
API_RATE_LIMIT_PER_MINUTE=600
SESSION_TTL_SECONDS=3600
MAX_ACTIVE_SESSIONS=100
MAX_ACTIVE_CASES=100
MAX_RUNS_PER_CASE=10

# Private manual-upload storage. Generate a 32-byte random value and store its
# base64 form only in .env.local. Without it, live document intake fails closed.
DOCUMENT_STORAGE_PATH=.local/documents
DOCUMENT_ENCRYPTION_KEY_BASE64=

# Live runs need explicit model-sharing permission in addition to case consent.
LLM_PROVIDER=google
GEMINI_API_KEY=
# Set an account-available model and its current rates from Google's official documentation.
LLM_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
ORCHESTRATION_RUN_BUDGET_USD=0.25
ORCHESTRATION_PROJECT_BUDGET_USD=5
# Optional live-model limits. Leave them commented to use the defaults shown; an empty value is
# rejected. LLM_MODEL_VERSION defaults to LLM_MODEL. GOOGLE_GENERATIVE_AI_API_KEY is accepted in
# place of GEMINI_API_KEY.
# LLM_MODEL_VERSION=
# LLM_MAX_INPUT_BYTES=48000
# LLM_MAX_OUTPUT_TOKENS=1500
# LLM_TIMEOUT_MS=30000
# LLM_MAX_CONCURRENT_CALLS=2

# Provider placeholders. Keys alone do not enable calls. Each connector remains
# fail-closed until its exact API contract, endpoint and verification method are implemented.
SARVAM_API_KEY=
GNANI_API_KEY_ID=
PINE_LABS_CLIENT_ID=
PINE_LABS_CLIENT_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=
