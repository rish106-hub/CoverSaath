# Copy these settings into .env.local. The server loads that ignored file.
# Never place keys in VITE_ variables or send them in chat.
# Local SQLite file. Keep it under the ignored .local directory.
DATABASE_PATH=.local/knowvia.sqlite
# Generate a random 32-byte value. Used only to create the first local household.
KNOWVIA_BOOTSTRAP_TOKEN=
API_RATE_LIMIT_PER_MINUTE=600
SESSION_TTL_SECONDS=3600
MAX_ACTIVE_SESSIONS=100
MAX_ACTIVE_CASES=100
MAX_RUNS_PER_CASE=10
# Compatibility only. Keep false outside isolated legacy tests.
ENABLE_LEGACY_DEMO_API=false

# Private manual-upload storage. Generate a 32-byte random value and store its
# base64 form only in .env.local. Without it, live document intake fails closed.
DOCUMENT_STORAGE_PATH=.local/documents
DOCUMENT_ENCRYPTION_KEY_BASE64=

# Live runs need explicit model-sharing permission in addition to case consent.
LLM_PROVIDER=google
GEMINI_API_KEY=
OPENAI_API_KEY=
# Set an account-available model and its current rates from Google's official documentation.
LLM_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
ORCHESTRATION_RUN_BUDGET_USD=0.25
ORCHESTRATION_PROJECT_BUDGET_USD=5
# Human demo contact. This opens the device dialler, not a telephony transfer.
HUMAN_HANDOFF_PHONE=+919749452397

# Policy breakdown (12 section agents + blind verifier per section). Accuracy-first; costs are capped per job.
# BREAKDOWN_LLM_MODEL falls back to LLM_MODEL. Rates fall back to LLM_*_USD_PER_MILLION.
BREAKDOWN_LLM_MODEL=
BREAKDOWN_INPUT_USD_PER_MILLION=
BREAKDOWN_OUTPUT_USD_PER_MILLION=
BREAKDOWN_JOB_BUDGET_USD=5
BREAKDOWN_MAX_INPUT_CHARACTERS=1200000
BREAKDOWN_MAX_OUTPUT_TOKENS=16000
BREAKDOWN_TIMEOUT_MS=240000
BREAKDOWN_MAX_CONCURRENT_CALLS=3
# Folder of reviewed, dated reference files for sections 10–12 (insurer-disclosures.json,
# regulatory-floor.json, procedure-costs.json). Empty: those values stay Unknown.
BREAKDOWN_REFERENCE_DIR=
# Sarvam Document AI language for OCR (BCP-47).
SARVAM_DOCUMENT_LANGUAGE=en-IN
# Comma-separated host suffixes Sarvam result downloads may come from. Set after the first live smoke test
# shows the real host; empty allows any public HTTPS host (redirects are always refused).
SARVAM_DOWNLOAD_HOST_SUFFIXES=
# Uploads stay quarantined until an antivirus scanner is integrated. structural_only is for local development.
DOCUMENT_SCAN_MODE=structural_only

# Provider placeholders. SARVAM_API_KEY enables live OCR for the policy breakdown (Doc AI digitise);
# the other connectors remain fail-closed until their contracts are implemented and verified.
SARVAM_API_KEY=
GNANI_API_KEY_ID=
PINE_LABS_CLIENT_ID=
PINE_LABS_CLIENT_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=
