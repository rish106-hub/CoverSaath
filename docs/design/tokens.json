{
  "$description": "Knowvia landing and onboarding design tokens (W3C Design Tokens format). Source of truth: docs/design/03-design-direction.md. Contrast ratios computed with WCAG 2.2.",
  "color": {
    "tide": {
      "$type": "color",
      "$value": "#163F42",
      "$description": "Headlines on light; dark band ground. Paper on it 11.51:1"
    },
    "tide-deep": {
      "$type": "color",
      "$value": "#0B383B",
      "$description": "Footer ground. Paper on it 12.78:1"
    },
    "harbour": {
      "$type": "color",
      "$value": "#176F69",
      "$description": "The only action colour. White on it 5.98:1"
    },
    "harbour-hover": {
      "$type": "color",
      "$value": "#125A55",
      "$description": "Button hover and press. White on it 8.02:1"
    },
    "harbour-tint": {
      "$type": "color",
      "$value": "#E3F0EE",
      "$description": "Known chip ground. Harbour text 5.11:1"
    },
    "gold": {
      "$type": "color",
      "$value": "#E0A02B",
      "$description": "Focus ring and Next marker only. Never text on light (2.27:1)"
    },
    "gold-tint": {
      "$type": "color",
      "$value": "#FBF1DD",
      "$description": "Not confirmed chip ground"
    },
    "gold-ink": {
      "$type": "color",
      "$value": "#7A5207",
      "$description": "Not confirmed text and icon. 6.17:1 on gold-tint"
    },
    "mist": {
      "$type": "color",
      "$value": "#F3F7F6",
      "$description": "Page ground"
    },
    "mist-deep": {
      "$type": "color",
      "$value": "#E6EFEC",
      "$description": "Alternate section ground"
    },
    "paper": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Cards and forms"
    },
    "ink": {
      "$type": "color",
      "$value": "#1A3034",
      "$description": "Body text. 13.85:1 on paper"
    },
    "slate": {
      "$type": "color",
      "$value": "#55696D",
      "$description": "Secondary text and sources. 5.79 paper, 5.36 mist, 4.94 mist-deep"
    },
    "fog": {
      "$type": "color",
      "$value": "#CFDCDA",
      "$description": "Decorative dividers only (1.41:1)"
    },
    "rule": {
      "$type": "color",
      "$value": "#7B918E",
      "$description": "Input and control borders. 3.34:1 on paper"
    },
    "tide-soft": {
      "$type": "color",
      "$value": "#C9DDD9",
      "$description": "Secondary text on tide. 8.13:1"
    },
    "brick": {
      "$type": "color",
      "$value": "#A74335",
      "$description": "Errors only. 6.00:1 on paper"
    },
    "dark": {
      "ground": {
        "$type": "color",
        "$value": "#0E2224"
      },
      "surface": {
        "$type": "color",
        "$value": "#132C2E"
      },
      "ink": {
        "$type": "color",
        "$value": "#E8F1EF",
        "$description": "14.34:1 on ground"
      },
      "muted": {
        "$type": "color",
        "$value": "#A9BEBA",
        "$description": "8.45:1 on ground"
      },
      "action": {
        "$type": "color",
        "$value": "#5FC2B4",
        "$description": "Text #0E2224 on it 7.75:1"
      },
      "gold": {
        "$type": "color",
        "$value": "#F1B53A",
        "$description": "8.96:1 on ground"
      },
      "rule": {
        "$type": "color",
        "$value": "#5B7774",
        "$description": "3.41:1 on ground"
      }
    },
    "highlight": {
      "$description": "Extended green and teal family (landing v2). Grounds and highlights only; never on buttons or links. Harbour stays the only action colour.",
      "sprout": {
        "$type": "color",
        "$value": "#DDF0DC",
        "$description": "Light green ground. Pine text 8.53, Fern 5.30"
      },
      "fern": {
        "$type": "color",
        "$value": "#2E6B4A",
        "$description": "Mid green for marks and small text. 5.30 on Sprout, 6.33 white on it"
      },
      "pine": {
        "$type": "color",
        "$value": "#0F4A3A",
        "$description": "Deep green ground (industry numbers). White on it 10.19"
      },
      "seafoam": {
        "$type": "color",
        "$value": "#CDEBE5",
        "$description": "Light teal ground. Tide text 9.11"
      },
      "mint": {
        "$type": "color",
        "$value": "#A8DCCB",
        "$description": "Highlight numbers on dark. 6.68 on Pine, 7.55 on Tide"
      },
      "lime": {
        "$type": "color",
        "$value": "#C8E6A0",
        "$description": "Strongest highlight: the headline marker and the top statistic. 7.42 on Pine"
      },
      "lagoon": {
        "$type": "color",
        "$value": "#1D8A80",
        "$description": "Chart fills only (4.20 on Paper fails as text)"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Newsreader",
          "Iowan Old Style",
          "Georgia",
          "serif"
        ]
      },
      "text": {
        "$type": "fontFamily",
        "$value": [
          "Source Sans 3",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Arial",
          "sans-serif"
        ]
      },
      "devanagari": {
        "$type": "fontFamily",
        "$value": [
          "Noto Sans Devanagari",
          "sans-serif"
        ]
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 400,
        "fontSize": "64px",
        "lineHeight": 1.05,
        "letterSpacing": "-0.015em"
      },
      "$extensions": {
        "mobile": {
          "fontSize": "42px",
          "lineHeight": 1.08,
          "letterSpacing": "-0.01em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 400,
        "fontSize": "44px",
        "lineHeight": 1.12,
        "letterSpacing": "-0.01em"
      },
      "$extensions": {
        "mobile": {
          "fontSize": "32px",
          "lineHeight": 1.15,
          "letterSpacing": "-0.005em"
        }
      }
    },
    "quote": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 400,
        "fontStyle": "italic",
        "fontSize": "30px",
        "lineHeight": 1.3,
        "letterSpacing": "0"
      },
      "$extensions": {
        "mobile": {
          "fontSize": "24px",
          "lineHeight": 1.32
        }
      }
    },
    "figure": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 400,
        "fontSize": "56px",
        "lineHeight": 1.0,
        "letterSpacing": "-0.01em",
        "fontVariantNumeric": "lining-nums"
      },
      "$extensions": {
        "mobile": {
          "fontSize": "40px"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 600,
        "fontSize": "22px",
        "lineHeight": 1.3,
        "letterSpacing": "0"
      },
      "$extensions": {
        "mobile": {
          "fontSize": "20px"
        }
      }
    },
    "lead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 400,
        "fontSize": "21px",
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$extensions": {
        "mobile": {
          "fontSize": "19px"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 400,
        "fontSize": "19px",
        "lineHeight": 1.6,
        "letterSpacing": "0"
      },
      "$extensions": {
        "mobile": {
          "fontSize": "17px"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 600,
        "fontSize": "15px",
        "lineHeight": 1.3,
        "letterSpacing": "0.01em"
      }
    },
    "source": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 400,
        "fontSize": "15px",
        "lineHeight": 1.45,
        "letterSpacing": "0"
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontWeight": 600,
        "fontSize": "17px",
        "lineHeight": 1,
        "letterSpacing": "0.005em"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "40px"
    },
    "8": {
      "$type": "dimension",
      "$value": "48px"
    },
    "9": {
      "$type": "dimension",
      "$value": "64px"
    },
    "10": {
      "$type": "dimension",
      "$value": "80px"
    },
    "11": {
      "$type": "dimension",
      "$value": "96px"
    },
    "12": {
      "$type": "dimension",
      "$value": "128px"
    },
    "section-y": {
      "$type": "dimension",
      "$value": "128px",
      "$extensions": {
        "mobile": "72px"
      }
    },
    "card-pad": {
      "$type": "dimension",
      "$value": "32px",
      "$extensions": {
        "mobile": "24px"
      }
    },
    "card-gap": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "layout": {
    "content-max": {
      "$type": "dimension",
      "$value": "1200px"
    },
    "columns": {
      "$value": {
        "desktop": 12,
        "tablet": 8,
        "mobile": 4
      }
    },
    "gutter": {
      "$value": {
        "desktop": "24px",
        "tablet": "24px",
        "mobile": "16px"
      }
    },
    "margin": {
      "$value": {
        "desktop": "80px",
        "tablet": "40px",
        "mobile": "20px"
      }
    },
    "measure": {
      "$value": {
        "body": "68ch",
        "lead": "54ch",
        "h2": "18ch"
      }
    }
  },
  "radius": {
    "chip": {
      "$type": "dimension",
      "$value": "6px"
    },
    "control": {
      "$type": "dimension",
      "$value": "10px"
    },
    "card": {
      "$type": "dimension",
      "$value": "16px"
    },
    "reading-card": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "shadow": {
    "lift": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "18px",
        "blur": "50px",
        "spread": "0px",
        "color": "rgba(22,62,54,0.09)"
      },
      "$description": "Once per screen: reading card or form card"
    }
  },
  "focus": {
    "ring": {
      "$value": "3px solid {color.gold}, offset 3px, inner 1px {color.tide}"
    }
  },
  "motion": {
    "press": {
      "$type": "transition",
      "$value": {
        "duration": "120ms",
        "timingFunction": "ease-out"
      }
    },
    "hover": {
      "$type": "transition",
      "$value": {
        "duration": "180ms",
        "timingFunction": "ease-out"
      }
    },
    "expand": {
      "$type": "transition",
      "$value": {
        "duration": "240ms",
        "timingFunction": [
          0.165,
          0.84,
          0.44,
          1
        ]
      }
    },
    "settle": {
      "$type": "transition",
      "$value": {
        "duration": "420ms",
        "timingFunction": [
          0.165,
          0.84,
          0.44,
          1
        ]
      },
      "$description": "Max 8px travel"
    },
    "reading": {
      "$type": "duration",
      "$value": "2200ms",
      "$description": "Hero sequence M1, once, no loop; reduced motion shows the final state"
    },
    "countUp": {
      "$type": "duration",
      "$value": "1600ms",
      "$description": "Numbers count from 0 once when their section enters view; ease-out-quart; final values shown by default and under reduced motion"
    },
    "marquee": {
      "$type": "duration",
      "$value": "48s clause band, 70s statistics track (reverse)",
      "$description": "Pause on hover; under reduced motion both wrap and duplicates are hidden"
    }
  },
  "size": {
    "hit-target-min": {
      "$type": "dimension",
      "$value": "44px"
    },
    "button-height": {
      "$type": "dimension",
      "$value": "52px",
      "$extensions": {
        "mobile": "56px"
      }
    }
  }
}