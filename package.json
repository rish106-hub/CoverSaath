{
  "name": "coversaath-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env.local --watch src/server/server.js",
    "db:init": "node --env-file-if-exists=.env.local scripts/database.mjs",
    "orchestrate": "node scripts/orchestration-demo.mjs",
    "eval:safety": "node scripts/run-safety-evals.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs tests/evals/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm test && npm run build"
  },
  "devDependencies": {
    "vite": "8.3.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.71",
    "@ai-sdk/openai": "^4.0.67",
    "ai": "^7.0.102"
  }
}
