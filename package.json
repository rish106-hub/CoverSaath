{
  "name": "knowvia-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/server/server.js",
    "worker": "node --env-file-if-exists=.env.local src/server/worker.js",
    "db:init": "node --env-file-if-exists=.env.local scripts/database.mjs",
    "seed:demo-household": "node scripts/seed-demo-household.js",
    "verify:user-data": "node scripts/verify-user-data.js",
    "backfill:adult-contacts": "node --env-file-if-exists=.env.local scripts/backfill-adult-contacts.mjs",
    "retention:sweep": "node --env-file-if-exists=.env.local scripts/retention-sweep.mjs",
    "eval:safety": "node scripts/run-safety-evals.mjs",
    "eval:household": "node scripts/eval-household-reasoning.mjs",
    "eval:retrieval": "node scripts/eval-retrieval-recall.mjs",
    "build": "node --check src/server/server.js",
    "test": "node --test tests/*.test.mjs tests/evals/*.test.mjs",
    "test:sarvam-live": "RUN_SARVAM_LIVE=1 node --env-file=.env --test tests/sarvam-live.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@sentry/node": "^11.11.0",
    "ai": "^7.0.159",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  }
}
