{
  "name": "knowvia-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env.local --watch src/server/server.js",
    "db:init": "node --env-file-if-exists=.env.local scripts/database.mjs",
    "orchestrate": "node scripts/orchestration-demo.mjs",
    "eval:safety": "node scripts/run-safety-evals.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs tests/evals/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm test && npm run build",
    "eval:breakdown": "node scripts/eval-breakdown.mjs --set fixtures",
    "eval:breakdown:live": "node --env-file-if-exists=.env.local scripts/eval-breakdown.mjs --set local",
    "test:e2e:api": "node --test tests/e2e/api-journey.test.mjs",
    "test:e2e:browser": "playwright test",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.71",
    "@ai-sdk/openai": "^4.0.67",
    "ai": "^7.0.102",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "posthog-js": "1.438.2"
  }
}
